<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Suite" >
    <groups>
        <run>
            <include name="Regression"/>
        </run>
    </groups>
    <test name="Regression">
        <classes>
            <class name="registry.EnumClassRegistryTest"/>
        </classes>
    </test>
    <listeners>
        <listener class-name="core.utils.TestListener"/>
    </listeners>
</suite>

