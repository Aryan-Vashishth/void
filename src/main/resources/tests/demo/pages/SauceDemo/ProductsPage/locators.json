{
  "ProductsPage" : {
    "Header" : {
      "Buttons" : {
        "MENU_BUTTON" : {
          "TRIGGER" : "//button[@id='react-burger-menu-btn']"
        },
        "CART_LINK" : {
          "TRIGGER" : "//a[@class='shopping_cart_link']"
        }
      },
      "Labels" : {
        "PAGE_TITLE" : {
          "TEXT" : "//span[@class='title']"
        },
        "CART_BADGE" : {
          "TEXT" : "//span[@class='shopping_cart_badge']"
        }
      }
    },
    "SideMenu" : {
      "ALL_ITEMS_LINK" : {
        "TRIGGER" : "//a[@id='inventory_sidebar_link']"
      },
      "ABOUT_LINK" : {
        "TRIGGER" : "//a[@id='about_sidebar_link']"
      },
      "LOGOUT_LINK" : {
        "TRIGGER" : "//a[@id='logout_sidebar_link']"
      },
      "RESET_APP_STATE_LINK" : {
        "TRIGGER" : "//a[@id='reset_sidebar_link']"
      },
      "CLOSE_MENU_BUTTON" : {
        "TRIGGER" : "//button[@id='react-burger-cross-btn']"
      }
    },
    "SortDropdown" : {
      "Controls" : {
        "SORT_SELECT" : {
          "TRIGGER" : "//select[@data-test='product_sort_container']"
        }
      },
      "Labels" : {
        "ACTIVE_OPTION_LABEL" : {
          "TEXT" : "//span[@class='active_option']"
        }
      }
    },
    "ProductItem" : {
      "Buttons" : {
        "ITEM_TITLE_LINK" : {
          "TRIGGER" : "//div[@class='inventory_item_name']/a"
        }
      },
      "DynamicButtons" : {
        "ADD_TO_CART_BUTTON" : {
          "TRIGGER" : "//button[@data-test='add-to-cart-%1$s']"
        },
        "REMOVE_BUTTON" : {
          "TRIGGER" : "//button[@data-test='remove-%1$s']"
        }
      },
      "Labels" : {
        "ITEM_NAME" : {
          "TEXT" : "//div[@class='inventory_item_name']"
        },
        "ITEM_NAME_AT" : {
          "TEXT" : "(//div[@class='inventory_item_name'])[%1$s]"
        },
        "ITEM_PRICE" : {
          "TEXT" : "//div[@class='inventory_item_price']"
        },
        "ITEM_PRICE_AT" : {
          "TEXT" : "(//div[@class='inventory_item_price'])[%1$s]"
        }
      }
    },
    "Footer" : {
      "TWITTER_LINK" : {
        "TRIGGER" : "//li[@class='social_twitter']/a"
      },
      "FACEBOOK_LINK" : {
        "TRIGGER" : "//li[@class='social_facebook']/a"
      },
      "LINKEDIN_LINK" : {
        "TRIGGER" : "//li[@class='social_linkedin']/a"
      }
    }
  }
}