{
  "LoginPage" : {
    "LoginForm" : {
      "Credentials" : {
        "USERNAME_FIELD" : {
          "INPUT" : "//input[@data-test='username']"
        },
        "PASSWORD_FIELD" : {
          "INPUT" : "//input[@data-test='password']"
        }
      },
      "Buttons" : {
        "LOGIN_BUTTON" : {
          "TRIGGER" : "//input[@data-test='login-button']"
        }
      }
    },
    "ErrorMessage" : {
      "Labels" : {
        "ERROR_BANNER" : {
          "TEXT" : "//div/h3[@data-test='error']"
        }
      },
      "Buttons" : {
        "ERROR_DISMISS" : {
          "TRIGGER" : "//div/h3[@data-test='error']/button"
        }
      }
    },
    "CredentialsPanel" : {
      "ACCEPTED_CREDENTIALS" : {
        "TEXT" : "//div[@id='login_credentials']"
      }
    }
  }
}