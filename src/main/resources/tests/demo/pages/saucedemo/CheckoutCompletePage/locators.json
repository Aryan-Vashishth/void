{
  "CheckoutCompletePage" : {
    "Header" : {
      "Buttons" : {
        "MENU_BUTTON" : {
          "TRIGGER" : "//button[@id='react-burger-menu-btn']"
        },
        "CART_LINK" : {
          "TRIGGER" : "//a[@class='shopping_cart_link']"
        }
      },
      "Labels" : {
        "PAGE_TITLE" : {
          "TEXT" : "//span[@class='title']"
        },
        "CART_BADGE" : {
          "TEXT" : "//span[@class='shopping_cart_badge']"
        }
      }
    },
    "SideMenu" : {
      "ALL_ITEMS_LINK" : {
        "TRIGGER" : "//a[@id='inventory_sidebar_link']"
      },
      "ABOUT_LINK" : {
        "TRIGGER" : "//a[@id='about_sidebar_link']"
      },
      "LOGOUT_LINK" : {
        "TRIGGER" : "//a[@id='logout_sidebar_link']"
      },
      "RESET_APP_STATE_LINK" : {
        "TRIGGER" : "//a[@id='reset_sidebar_link']"
      },
      "CLOSE_MENU_BUTTON" : {
        "TRIGGER" : "//button[@id='react-burger-cross-btn']"
      }
    },
    "OrderConfirmation" : {
      "PONY_EXPRESS_IMAGE" : {
        "TEXT" : "//img[@class='pony_express']"
      },
      "COMPLETE_HEADER" : {
        "TEXT" : "//h2[@class='complete-header']"
      },
      "COMPLETE_TEXT" : {
        "TEXT" : "//div[@class='complete-text']"
      }
    },
    "Actions" : {
      "BACK_HOME_BUTTON" : {
        "TRIGGER" : "//button[@data-test='back-to-products']"
      },
      "GENERATE_PDF_BUTTON" : {
        "TRIGGER" : "//button[@data-test='generate-pdf-order']"
      }
    },
    "Footer" : {
      "TWITTER_LINK" : {
        "TRIGGER" : "//li[@class='social_twitter']/a"
      },
      "FACEBOOK_LINK" : {
        "TRIGGER" : "//li[@class='social_facebook']/a"
      },
      "LINKEDIN_LINK" : {
        "TRIGGER" : "//li[@class='social_linkedin']/a"
      }
    }
  }
}