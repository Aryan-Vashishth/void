{
  "CheckoutStepTwoPage" : {
    "Header" : {
      "Buttons" : {
        "MENU_BUTTON" : {
          "TRIGGER" : "//button[@id='react-burger-menu-btn']"
        },
        "CART_LINK" : {
          "TRIGGER" : "//a[@class='shopping_cart_link']"
        }
      },
      "Labels" : {
        "PAGE_TITLE" : {
          "TEXT" : "//span[@class='title']"
        },
        "CART_BADGE" : {
          "TEXT" : "//span[@class='shopping_cart_badge']"
        }
      }
    },
    "SideMenu" : {
      "ALL_ITEMS_LINK" : {
        "TRIGGER" : "//a[@id='inventory_sidebar_link']"
      },
      "ABOUT_LINK" : {
        "TRIGGER" : "//a[@id='about_sidebar_link']"
      },
      "LOGOUT_LINK" : {
        "TRIGGER" : "//a[@id='logout_sidebar_link']"
      },
      "RESET_APP_STATE_LINK" : {
        "TRIGGER" : "//a[@id='reset_sidebar_link']"
      },
      "CLOSE_MENU_BUTTON" : {
        "TRIGGER" : "//button[@id='react-burger-cross-btn']"
      }
    },
    "OrderSummary" : {
      "CartItem" : {
        "Buttons" : {
          "ITEM_TITLE_LINK" : {
            "TRIGGER" : "//div[@class='inventory_item_name']/a"
          }
        },
        "Labels" : {
          "QUANTITY" : {
            "TEXT" : "//div[@class='cart_quantity']"
          },
          "ITEM_PRICE" : {
            "TEXT" : "//div[@class='inventory_item_price']"
          }
        }
      },
      "PaymentInfo" : {
        "LABEL" : {
          "TEXT" : "//div[@data-test='payment-info-label']"
        },
        "VALUE" : {
          "TEXT" : "//div[@data-test='payment-info-value']"
        }
      },
      "ShippingInfo" : {
        "LABEL" : {
          "TEXT" : "//div[@data-test='shipping-info-label']"
        },
        "VALUE" : {
          "TEXT" : "//div[@data-test='shipping-info-value']"
        }
      },
      "PriceTotal" : {
        "SUBTOTAL_LABEL" : {
          "TEXT" : "//div[@class='summary_subtotal_label']"
        },
        "TAX_LABEL" : {
          "TEXT" : "//div[@class='summary_tax_label']"
        },
        "TOTAL_LABEL" : {
          "TEXT" : "//div[@class='summary_total_label']"
        }
      }
    },
    "Actions" : {
      "CANCEL_BUTTON" : {
        "TRIGGER" : "//button[@data-test='cancel']"
      },
      "FINISH_BUTTON" : {
        "TRIGGER" : "//button[@data-test='finish']"
      }
    },
    "Footer" : {
      "TWITTER_LINK" : {
        "TRIGGER" : "//li[@class='social_twitter']/a"
      },
      "FACEBOOK_LINK" : {
        "TRIGGER" : "//li[@class='social_facebook']/a"
      },
      "LINKEDIN_LINK" : {
        "TRIGGER" : "//li[@class='social_linkedin']/a"
      }
    }
  }
}