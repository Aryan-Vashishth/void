{
  "CheckoutStepOnePage" : {
    "Header" : {
      "Buttons" : {
        "MENU_BUTTON" : {
          "TRIGGER" : "//button[@id='react-burger-menu-btn']"
        },
        "CART_LINK" : {
          "TRIGGER" : "//a[@class='shopping_cart_link']"
        }
      },
      "Labels" : {
        "PAGE_TITLE" : {
          "TEXT" : "//span[@class='title']"
        },
        "CART_BADGE" : {
          "TEXT" : "//span[@class='shopping_cart_badge']"
        }
      }
    },
    "SideMenu" : {
      "ALL_ITEMS_LINK" : {
        "TRIGGER" : "//a[@id='inventory_sidebar_link']"
      },
      "ABOUT_LINK" : {
        "TRIGGER" : "//a[@id='about_sidebar_link']"
      },
      "LOGOUT_LINK" : {
        "TRIGGER" : "//a[@id='logout_sidebar_link']"
      },
      "RESET_APP_STATE_LINK" : {
        "TRIGGER" : "//a[@id='reset_sidebar_link']"
      },
      "CLOSE_MENU_BUTTON" : {
        "TRIGGER" : "//button[@id='react-burger-cross-btn']"
      }
    },
    "CheckoutInfoForm" : {
      "Fields" : {
        "FIRST_NAME_INPUT" : {
          "INPUT" : "//input[@data-test='firstName']"
        },
        "LAST_NAME_INPUT" : {
          "INPUT" : "//input[@data-test='lastName']"
        },
        "POSTAL_CODE_INPUT" : {
          "INPUT" : "//input[@data-test='postalCode']"
        }
      },
      "Buttons" : {
        "CANCEL_BUTTON" : {
          "TRIGGER" : "//button[@data-test='cancel']"
        },
        "CONTINUE_BUTTON" : {
          "TRIGGER" : "//input[@data-test='continue']"
        }
      }
    },
    "ErrorMessage" : {
      "ERROR_BANNER" : {
        "TEXT" : "//div/h3[@data-test='error']"
      }
    },
    "Footer" : {
      "TWITTER_LINK" : {
        "TRIGGER" : "//li[@class='social_twitter']/a"
      },
      "FACEBOOK_LINK" : {
        "TRIGGER" : "//li[@class='social_facebook']/a"
      },
      "LINKEDIN_LINK" : {
        "TRIGGER" : "//li[@class='social_linkedin']/a"
      }
    }
  }
}