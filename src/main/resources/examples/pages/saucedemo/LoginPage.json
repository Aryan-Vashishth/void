{
  "LoginPage": {
    "LoginForm": {
      "USERNAME_FIELD": {
        "INPUT": "//input[@data-test='username']"
      },
      "PASSWORD_FIELD": {
        "INPUT": "//input[@data-test='password']"
      },
      "LOGIN_BUTTON": {
        "TRIGGER": "//input[@data-test='login-button']"
      }
    },
    "ErrorMessage": {
      "ERROR_BANNER": {
        "TEXT": "//h3[@data-test='error']",
        "CLOSE_BUTTON": "//button[@data-test='error-button']"
      }
    },
    "CredentialsPanel": {
      "ACCEPTED_CREDENTIALS": {
        "TEXT": "//div[@data-test='login-credentials-container']"
      }
    }
  }
}