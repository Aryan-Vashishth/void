<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>VOID</artifactId>
    <version>2.0-SNAPSHOT</version>

    <!-- =========================================================
         Dependency Versions — update here, nowhere else
         ========================================================= -->
    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>   <!-- ✏️ update: java.version in <properties> -->
        <maven.compiler.target>${java.version}</maven.compiler.target>   <!-- ✏️ update: java.version in <properties> -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Core -->
        <selenium.version>4.38.0</selenium.version>
        <webdrivermanager.version>6.3.3</webdrivermanager.version>
        <testng.version>7.11.0</testng.version>

        <!-- Cucumber + Reporting -->
        <cucumber.version>7.31.0</cucumber.version>
        <extentreports-cucumber7-adapter.version>1.14.0</extentreports-cucumber7-adapter.version>

        <!-- Jackson (managed via BOM — see dependencyManagement) -->
        <jackson.version>2.19.0</jackson.version>

        <!-- Annotations -->
        <jsr305.version>3.0.2</jsr305.version>
        <jetbrains-annotations.version>26.0.2</jetbrains-annotations.version>

        <!-- Utilities -->
        <log4j2.version>2.25.4</log4j2.version>  <!-- ✏️ update: log4j2.version in <properties> —— replaces EOL log4j 1.x (6 CVEs) -->
        <lombok.version>1.18.42</lombok.version>
        <javafaker.version>1.0.2</javafaker.version>

        <!-- Plugins -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    </properties>

    <!-- =========================================================
         Managed versions (BOM-style for Jackson)
         ========================================================= -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>                     <!-- ✏️ update: jackson.version in <properties> -->
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- =========================================================
         Build Plugins
         ========================================================= -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>       <!-- ✏️ update: maven-compiler-plugin.version in <properties> -->
                <configuration>
                    <release>${java.version}</release>                    <!-- ✏️ update: java.version in <properties> -->
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>       <!-- ✏️ update: maven-surefire-plugin.version in <properties> -->
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>src/testNgXml/testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- =========================================================
         Dependencies
         ========================================================= -->
    <dependencies>

        <!-- ── Selenium ─────────────────────────────────────── -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>                        <!-- ✏️ update: selenium.version in <properties> -->
        </dependency>
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>                <!-- ✏️ update: webdrivermanager.version in <properties> -->
        </dependency>

        <!-- ── Cucumber ──────────────────────────────────────── -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>                        <!-- ✏️ update: cucumber.version in <properties> -->
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-testng</artifactId>
            <version>${cucumber.version}</version>                        <!-- ✏️ update: cucumber.version in <properties> -->
        </dependency>

        <!-- ── Reporting ─────────────────────────────────────── -->
        <dependency>
            <groupId>tech.grasshopper</groupId>
            <artifactId>extentreports-cucumber7-adapter</artifactId>
            <version>${extentreports-cucumber7-adapter.version}</version> <!-- ✏️ update: extentreports-cucumber7-adapter.version in <properties> -->
        </dependency>

        <!-- ── TestNG ────────────────────────────────────────── -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>                          <!-- ✏️ update: testng.version in <properties> -->
        </dependency>

        <!-- ── Jackson (versions managed by BOM above) ───────── -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
                                                                          <!-- ✏️ update: jackson.version in <properties> → managed by jackson-bom -->
        </dependency>

        <!-- ── Logging (Log4j 2 — replaces EOL log4j 1.x) ──────── -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j2.version}</version>                          <!-- ✏️ update: log4j2.version in <properties> -->
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j2.version}</version>                          <!-- ✏️ update: log4j2.version in <properties> -->
        </dependency>
        <!-- Bridge: keeps "import org.apache.log4j.Logger" working without code changes -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-1.2-api</artifactId>
            <version>${log4j2.version}</version>                          <!-- ✏️ update: log4j2.version in <properties> -->
        </dependency>

        <!-- ── Annotations ───────────────────────────────────── -->
        <!-- JSR-305: provides javax.annotation.Nullable / Nonnull -->
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
            <version>${jsr305.version}</version>                          <!-- ✏️ update: jsr305.version in <properties> -->
        </dependency>
        <!-- JetBrains: provides org.jetbrains.annotations.NotNull / Nullable -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>${jetbrains-annotations.version}</version>           <!-- ✏️ update: jetbrains-annotations.version in <properties> -->
        </dependency>

        <!-- ── Utilities ─────────────────────────────────────── -->
        <dependency>
            <groupId>com.github.javafaker</groupId>
            <artifactId>javafaker</artifactId>
            <version>${javafaker.version}</version>                       <!-- ✏️ update: javafaker.version in <properties> -->
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>                          <!-- ✏️ update: lombok.version in <properties> -->
            <scope>provided</scope>
        </dependency>

    </dependencies>
</project>
